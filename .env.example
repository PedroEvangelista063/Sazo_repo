# Variáveis de ambiente - COPIE para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais

# PostgreSQL (Arquitetura Medalhão)
# role_etl_writer: usado pelo pipeline de ingestão
DATABASE_URL=postgresql://role_etl_writer:senha_aqui@localhost:5432/quero_comprar

# role_api_reader: usado pela FastAPI (apenas leitura no schema mart)
DATABASE_URL_READER=postgresql://role_api_reader:senha_aqui@localhost:5432/quero_comprar

# Redis (opcional no MVP, necessário para produção)
REDIS_URL=redis://localhost:6379/0

# Backend FastAPI
API_SECRET_KEY=troque-por-uma-chave-secreta-longa
ALLOWED_ORIGINS=http://localhost:3000,https://querocomprar.app

# Ambiente
ENV=development

# Timeout HTTP para download CONAB (segundos)
REQUEST_TIMEOUT=180
