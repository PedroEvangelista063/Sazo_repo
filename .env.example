# ─────────────────────────────────────────────────────────
# QUERO COMPRAR — Variáveis de Ambiente (GLOBAIS)
# ─────────────────────────────────────────────────────────
#
# ATENÇÃO: As variáveis de CONEXÃO COM O BANCO ficam em:
#   backend/.env  (pydantic-settings lê dele)
#
# O frontend usa frontend/.env (VITE_API_URL)
# ─────────────────────────────────────────────────────────

# ── API Config ──────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
API_V1_PREFIX="/api/v1"
RATE_LIMIT_PER_MINUTE=60
DEBUG=true

# ── Failover / Alta Disponibilidade ─────────────────────
# PRIMARY: banco remoto (ex.: Aiven).
# FALLBACK: banco local de standby (mesmo schema, dados read-only).
# Se PRIMARY vazio, usa DATABASE_URL. Se FALLBACK vazio, usa DATABASE_URL_LOCAL_BACKUP.
DATABASE_URL_PRIMARY="postgresql://avnadmin:senha@SEU-SERVICO.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL_FALLBACK="postgresql://postgres:senha_local@localhost:5432/quero_comprar"

# ── Cache ───────────────────────────────────────────────
CACHE_TTL_SECONDS=86400

# ── Internal API Key (protege /_internal/*) ─────────────
# Em produção, gere uma chave forte: openssl rand -hex 32
INTERNAL_API_KEY=""

# ── LLM (Ghost DBA Agent) ──────────────────────────────
LLM_API_KEY=""
LLM_API_ENDPOINT=""

# ── URLs CONAB ──────────────────────────────────────────
CONAB_URL_UF="https://portaldeinformacoes.conab.gov.br/downloads/arquivos/PrecosMensalUF.txt"
CONAB_URL_MUN="https://portaldeinformacoes.conab.gov.br/downloads/arquivos/PrecosMensalMunicipio.txt"
