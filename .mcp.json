{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "engram": {
      "command": "/home/pedroeduardo/.local/bin/engram",
      "args": ["mcp", "--tools=agent"]
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=kxsqrcccaaxplpktmutl"
    }
  }
}
