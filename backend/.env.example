# ─────────────────────────────────────────────────────────
# QUERO COMPRAR — Backend (dev) — EXEMPLO
# ─────────────────────────────────────────────────────────
#
# Copie para backend/.env e preencha as credenciais reais.
# backend/.env já está no .gitignore — não versiona segredos.
#
# REMOTE (Primary — Active):
#   Aiven (pg-2d41b051, plano free-1-1gb)
#
#   No Aiven nao ha separacao de poolers (Supabase descontinuado):
#   todas as URLs usam a mesma porta 26536 (sslmode=require).
#
# LOCAL (Standby — Backup/Sandbox):
#   DATABASE_URL_LOCAL_BACKUP = PostgreSQL nativo no Linux Mint
#   Usado apenas para snapshots de segurança e testes.
# ─────────────────────────────────────────────────────────

# ── Aiven Remoto (PRIMARY — Active) ─────────────────────
DATABASE_URL_PRIMARY="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL_API="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL_ETL="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"

# ── PostgreSQL Local (STANDBY — Backup/Sandbox) ─────────
# Crie o banco local com: sudo -u postgres createdb quero_comprar
DATABASE_URL_LOCAL_BACKUP="postgresql://postgres:SUA_SENHA_LOCAL@localhost:5432/quero_comprar"

# ── API Config ──────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
API_V1_PREFIX="/api/v1"
RATE_LIMIT_PER_MINUTE=60
DEBUG=true

# ── Cache ───────────────────────────────────────────────
CACHE_TTL_SECONDS=86400

# ── Internal API Key (protege /_internal/*) ─────────────
INTERNAL_API_KEY=""

# ── Pool de Conexão ─────────────────────────────────────
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
