# ─────────────────────────────────────────────────────────
# QUERO COMPRAR — Backend (dev) — EXEMPLO
# ─────────────────────────────────────────────────────────
#
# Copie para backend/.env e preencha as credenciais reais.
# backend/.env já está no .gitignore — não versiona segredos.
#
# REMOTE (Primary — Active):
#   Supabase remoto (kxsqrcccaaxplpktmutl)
#
#   DATABASE_URL         = Session Pooler (5432) — DDL, ETL, queries longas
#   DATABASE_URL_API     = Transaction Pooler (6543) — API, FastAPI/asyncpg (reads)
#   DATABASE_URL_ETL     = Session Pooler (5432) — ETL, cargas, refresh MVs
#
# LOCAL (Standby — Backup/Sandbox):
#   DATABASE_URL_LOCAL_BACKUP = PostgreSQL nativo no Linux Mint
#   Usado apenas para snapshots de segurança e testes.
# ─────────────────────────────────────────────────────────

# ── Supabase Remoto (PRIMARY — Active) ──────────────────
DATABASE_URL="postgresql://postgres.kxsqrcccaaxplpktmutl:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
DATABASE_URL_API="postgresql://postgres.kxsqrcccaaxplpktmutl:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL_ETL="postgresql://postgres.kxsqrcccaaxplpktmutl:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# ── PostgreSQL Local (STANDBY — Backup/Sandbox) ─────────
# Crie o banco local com: sudo -u postgres createdb quero_comprar
DATABASE_URL_LOCAL_BACKUP="postgresql://postgres:postgres_dev_local@localhost:5432/quero_comprar"

# ── API Config ──────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
API_V1_PREFIX="/api/v1"
RATE_LIMIT_PER_MINUTE=60
DEBUG=true

# ── Cache ───────────────────────────────────────────────
CACHE_TTL_SECONDS=86400

# ── Internal API Key (protege /_internal/*) ─────────────
INTERNAL_API_KEY=""

# ── Pool de Conexão ─────────────────────────────────────
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
