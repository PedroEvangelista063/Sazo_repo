[TEMPLATE]
# ─────────────────────────────────────────────────────────
# QUERO COMPRAR — Backend — EXEMPLO (Dual-Environment)
# ─────────────────────────────────────────────────────────
#
# ⚠️ NUNCA versionar credenciais reais. Copie este template para:
#      backend/.env.staging     (homologação — servidor FÍSICO/local)
#      backend/.env.production  (produção — nuvem Aiven)
#      backend/.env             (legado/fallback — mesmo conteúdo do staging)
#
# A fronteira de ambiente é ditada pelo APP_ENV do processo:
#   export APP_ENV=production   → carrega backend/.env.production
#   export APP_ENV=staging      → carrega backend/.env.staging (padrão)
#   (sem APP_ENV)               → tenta .env.staging e cai em backend/.env
#
# Pool de conexões (asyncpg) é AUTOTUNADO por ambiente quando POOL_MIN_SIZE/
# POOL_MAX_SIZE não são informados:
#   staging    → min 2 / max 30 (testes de carga no físico)
#   production → min 2 / max 8  (Aiven free/basic — conexões limitadas)
#
# ─────────────────────────────────────────────────────────

# ── AMBIENTE ─────────────────────────────────────────────
# APP_ENV=staging | production (informativo aqui — quem decide é o processo)

# ── Aiven Remoto (PRIMARY — Production) ──────────────────
# No Aiven nao ha separacao de poolers (Supabase descontinuado): todas as
# URLs usam a mesma porta 26536 (sslmode=require).
DATABASE_URL_PRIMARY="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL_API="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"
DATABASE_URL_ETL="postgresql://avnadmin:SUA_SENHA@SEU-SERVICO-USER-PROJ.aivencloud.com:26536/defaultdb?sslmode=require"

# ── PostgreSQL Local (STANDBY / Homologação FÍSICA) ──────
# Crie o banco local com: sudo -u postgres createdb quero_comprar
DATABASE_URL_LOCAL_BACKUP="postgresql://postgres:SUA_SENHA_LOCAL@localhost:5432/quero_comprar"

# ── API Config ──────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
API_V1_PREFIX="/api/v1"
RATE_LIMIT_PER_MINUTE=60
# staging=true (DEBUG verboso) | production=false (WARNING/ERROR)
DEBUG=true

# ── Cache ───────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── Internal API Key (protege /_internal/*) ─────────────
INTERNAL_API_KEY=""

# ── Pool de Conexão (opcional — autotunado por ambiente) ─
POOL_MIN_SIZE=2
POOL_MAX_SIZE=30
