# ─────────────────────────────────────────────────────────
# QUERO COMPRAR — Frontend — EXEMPLO (Dual-Environment)
# ─────────────────────────────────────────────────────────
# Copie para frontend/.env.staging ou frontend/.env.production
# conforme o ambiente (ou use frontend/.env para dev legado).
#
# O Vite carrega o .env do MODO:
#   npm run dev           → modo development  → frontend/.env (ou .env.development)
#   npm run dev:staging   → modo staging      → frontend/.env.staging
#   npm run dev:production→ modo production   → frontend/.env.production
#   npm run build         → modo production   → frontend/.env.production
#
# Staging (servidor físico): backend em localhost:8000
# Production (nuvem):        backend na URL do Render/Aiven
# ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
