{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "eslint": {
      "command": ["npx", "-y", "vscode-langservers-extracted", "--stdio"],
      "disabled": false
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },
    "engram": {
      "type": "local",
      "command": ["/home/pedroeduardo/.local/bin/engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=kxsqrcccaaxplpktmutl&read_only=true&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}